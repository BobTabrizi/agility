{
  "name": "agility",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && node scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/server.cjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dynamo": "cross-env RUN_DYNAMODB_TESTS=1 vitest run src/server/dynamoRoomStore.test.ts",
    "test:dynamo:local": "cross-env-shell RUN_DYNAMODB_TESTS=1 AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000 DYNAMODB_TEST_TABLE=agility-local-test AWS_REGION=us-west-1 AWS_ACCESS_KEY_ID=local AWS_SECRET_ACCESS_KEY=local \"node scripts/create-local-tables.mjs && vitest run src/server/dynamoRoomStore.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/lib-dynamodb": "^3.1138.0",
    "cross-env": "^10.1.0",
    "nanoid": "^5.1.16",
    "next": "16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
